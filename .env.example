# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=your_database_connection_url

# App URL (Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# JWT Secret — MUST be set in Vercel environment variables
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=replace_with_a_strong_random_secret

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Web Push / VAPID (for push notifications)
# Public key goes in both client + server; private key server-only
NEXT_PUBLIC_VAPID_PUBLIC_KEY=UqGOkZcU9i3aSdi9POucob7OHpqm9cjeFOMnjhEisSpQtZTZUwDNstSNVWsT6tYq_s9gPe0yoYqggHTi4buPOA
VAPID_PRIVATE_KEY=replace_with_a_server_only_vapid_private_key
VAPID_SUBJECT=mailto:admin@sharableofc.app
